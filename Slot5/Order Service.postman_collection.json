      "name": "TC01 - POST Create Order - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response body is correct message\", function () {",
              "    pm.expect(pm.response.text()).to.eql(\"Order Placed Successfully\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"skuCode\": \"iphone_15\",\n  \"price\": 1000,\n  \"quantity\": 1\n}"
        },
        "url": {
          "raw": "{{order_base_url}}/api/order",
          "host": [
            "{{order_base_url}}"
          ],
          "path": [
            "api",
            "order"
          ]
        }
