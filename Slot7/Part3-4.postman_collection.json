	"item": [
		{
			"name": "0. Keycloak Auth",
			"item": [
				{
					"name": "Get Access Token (Client Credentials)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Lấy token thành công 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const json = pm.response.json();",
									"pm.test(\"Có access_token\", () => {",
									"    pm.expect(json.access_token).to.be.a('string');",
									"});",
									"",
									"if (json.access_token) {",
									"    pm.collectionVariables.set(\"bearerToken\", json.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "{{clientId}}",
									"type": "text"
								},
								{
									"key": "client_secret",
									"value": "{{clientSecret}}",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{keycloak}}/protocol/openid-connect/token",
							"host": [
								"{{keycloak}}"
							],
							"path": [
								"protocol",
								"openid-connect",
								"token"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Token with Wrong Secret (Expect 401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Sai secret bị từ chối 401\", () => {",
									"    pm.response.to.have.status(401);",
									"});",
									"pm.test(\"Error là unauthorized_client\", () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json.error).to.eql(\"unauthorized_client\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "{{clientId}}",
									"type": "text"
								},
								{
									"key": "client_secret",
									"value": "wrong_secret_123",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{keycloak}}/protocol/openid-connect/token",
							"host": [
								"{{keycloak}}"
							],
							"path": [
